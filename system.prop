# 防止应用多次闪退触发 Rescue Party Plus 导致数据被清空
persist.sys.rescuepartyplus.disable=1

# 强制启用 AOD 的 1Hz 刷新率
ro.vendor.mi_sf.aod_mode_ddic_refresh_rate=1

# 停用刷新率切换的亮度
persist.vendor.disable_idle_fps.threshold=1

# 禁用应用预加载
# persist.sys.prestart.proc=false

# 开启相机新版徕卡UI, 徕卡一瞬和实况运镜为UI
ro.theme_customize=LCC
ro.boot.product.theme_customize =P1_Leica
ro.leica.camera=true
ro.product.essential.support=1
